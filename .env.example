# Public OAuth identifier created in Google Cloud Console for a Web application.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Generate a long random value for production. Changing it signs out existing sessions.
APP_ENV=development
AUTH_SESSION_SECRET=replace-with-at-least-48-random-characters
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://igris.site,https://www.igris.site
ALLOWED_HOSTS=api.igris.site,localhost,127.0.0.1
SERVE_FRONTEND=true
ADMIN_EMAILS=admin@example.com
# Optional: bind admin access to immutable Google subject IDs after first login.
ADMIN_GOOGLE_SUBS=

# On api.igris.site use APP_ENV=production, AUTH_COOKIE_SECURE=true, and SERVE_FRONTEND=false.

# DeepSeek V4 Flash is the economical default. The admin kill switch starts disabled.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
DeepSeek_Key=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=800
LLM_DAILY_USER_LIMIT=20
LLM_GLOBAL_DAILY_LIMIT=300
