# Public OAuth identifier created in Google Cloud Console for a Web application.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Generate a long random value for production. Changing it signs out existing sessions.
APP_ENV=development
AUTH_SESSION_SECRET=replace-with-at-least-48-random-characters
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=604800
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://igris.site,https://www.igris.site

# On the igris.site host use APP_ENV=production and AUTH_COOKIE_SECURE=true.

# Any OpenAI-compatible local or hosted model can be used without frontend changes.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=gemma-4-e2b-it
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
